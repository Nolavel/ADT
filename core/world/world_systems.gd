# =============================================================================
# WorldSystems.gd — Autoload (singleton)
#
# Центральная шина состояния игры. Хранит всё, что должно пережить смену сцен:
# точку спавна, текущий район, путь к данным мира.
#
# Конвенция высоты: уровень моря = Y 0, высота читается прямо с pos.y.
#
# Страт как технической сущности больше нет (переезд на остров, 2026-08-25):
# высота = статус остаётся, но непрерывно, через рельеф. Доггерленд /
# Манифолд / Глэйр живут только как разговорные имена районов в диалогах и
# текстах — код о них не знает.
#
# ТАЙЛОВОЙ СЕТКИ ЗЕМЛИ ТОЖЕ БОЛЬШЕ НЕТ. Сетка 3×3 плит по 2200 м держала пол
# города и давала стримингу второй тип ячейки со своей кольцевой метрикой.
# Земля теперь одна — рельеф острова, статический меш с HeightMapShape3D в
# world.tscn, который никто не стримит и который не надо описывать данными.
#
# Никакой физики (Area3D и т.п.) — только чистая математика по позиции.
# =============================================================================

extends Node

# ── Константы мира ────────────────────────────────────────────────────────────

## Габарит мира по XZ — граница, за которую игрока не выпускают
## (`WorldBorderGuardSystem`) и по которой рисуется отладочный бокс.
## Было 9600 × 9600 — габарит вертикального города. Теперь это ровно размер
## плоскости террейна острова: дальше неё нет ни рельефа, ни коллизии, только
## плоскость океана, поэтому граница мира и край карты — одно и то же.
const WORLD_ZONE_SIZE    := Vector2(3500.0, 3500.0)

## Потолок игрового пространства над уровнем моря. Поднят с 1000 до 1250,
## чтобы над смысловой башней (1000 м, стоит на дне кальдеры около 110 м, то
## есть макушка около 1110) оставался воздух — на потолке ровно по верхушке
## ховер упирался бы в невидимую крышку прямо на ней.
const GAMEPLAY_HEIGHT    := 1250.0

const DISTRICT_A1        := Vector2(0.0,    1600.0)
const DISTRICT_A2        := Vector2(2000.0, 6000.0)
const DISTRICT_A3        := Vector2(6000.0, 8600.0)


# ── Данные сессии ─────────────────────────────────────────────────────────────

## Точка появления игрока — ТОЧКА НА ПОЛУ, подъём капсулы делает
## `world.gd`'s SPAWN_CLEARANCE. Рядом с тестовым кластером (ночлежка, толпа,
## ховер, дроны), чтобы прогон начинался у того, что проверяется. 130.062 —
## рельеф в этой точке по запечённой карте высот, с учётом сдвига
## TerrainStaticBody 0.55.
##
## Это значение — только запасное. `world.gd` перезаписывает его
## `world_data.spawn_point`, если тот не нулевой, поэтому настоящий спавн
## живёт в `data/world_data.tres` и обязан совпадать с этим числом.
##
## ВРЕМЕННО. Кластер стоит на западном склоне Маруямы, который ТЗ оставляет
## незастроенным; переставлять его — работа в редакторе, по месту, вместе с
## расстановкой на шаге 5. Это отладочный спавн, а не проектное решение.
var spawn_point: Vector3 = Vector3(220.0, 130.062, -140.0)

var world_data_path: String = "res://data/world_data.tres"

var current_district: String = ""
var current_tower_id: String = ""

# ── Сигналы ───────────────────────────────────────────────────────────────────

signal district_changed(new_district: String)
signal spawn_point_updated(point: Vector3)


# ── Состояние сессии ──────────────────────────────────────────────────────────

func set_spawn_point(point: Vector3) -> void:
	spawn_point = point
	spawn_point_updated.emit(point)
	print("[WorldSystems] Spawn point: ", point)


func set_current_district(district: String) -> void:
	if district == current_district:
		return
	current_district = district
	district_changed.emit(district)
	print("[WorldSystems] District: ", district)
