# =============================================================================
# generate_city_cli.gd — та же генерация без редактора.
#
# ЗАПУСК: godot --headless --script res://tools/city_generator/generate_city_cli.gd
#
# Существует потому, что EditorScript из CLI не выполняется (проверено: --script
# на EditorScript молча ничего не делает), а агентской сессии нужен способ
# прогнать генератор и посмотреть на числа, не открывая редактор.
#
# _initialize(), а не _init(): у SceneTree первый — колбэк главного цикла,
# второй — конструктор. quit() из конструктора цикл не останавливает, и процесс
# висит без единой строки вывода.
# =============================================================================
extends SceneTree


func _initialize() -> void:
	var generator := CityGenerator.new()
	generator.generate()
	quit()
