# =============================================================================
# GroundTileData.gd
# Resource — описывает одну плиту земли (ground tile). Хранится в WorldData.tres.
#
# Запись намеренно минимальна:
#   • Позиция плиты НЕ хранится — она выводится из (row, col) методом
#     WorldSystems.get_tile_position(). Единственный источник истины по
#     геометрии сетки — константы WorldSystems; данные не могут с ними
#     разойтись.
#
# id плиты тоже выводится: "gt_r{row}_c{col}" (см. WorldSystems).
# =============================================================================

extends Resource
class_name GroundTileData

## Индекс по оси Z (0..2 для сетки 3×3).
@export var row: int

## Индекс по оси X (0..2 для сетки 3×3).
@export var col: int

## Ring 1: визуальный контент плиты (без коллизии — коллизия живёт в силуэте
## и не выгружается никогда: правило страховочной поверхности).
@export_file("*.tscn") var content_scene_path: String

## Ring 0: силуэт плиты (коллизия + простой меш), свой на каждую плиту.
@export_file("*.tscn") var silhouette_scene_path: String
