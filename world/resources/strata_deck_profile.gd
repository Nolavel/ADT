# =============================================================================
# strata_deck_profile.gd — StrataDeckProfile (Resource)
# class_name: StrataDeckProfile
#
# Тюнинг вертикального ритма ОДНОЙ страты (паттерн A/B/C). Правишь .tres в
# инспекторе → пере-Run билдера. Числа ловятся ногами, а не на бумаге.
#
# Привязка паттерна к страте — глобальная подпись мира:
#   Doggerland → A «варрен», Manifold → B «утилитарная», Glare → C «атриум».
#
# ГЕОМЕТРИЯ СЮДА НЕ ВХОДИТ (решение 2026-07-24): форма, размер и толщина плит
# и палуб приходят из авторских .tres-мешей (assets/floor_meshes/). Размер
# башни на страте = AABB меша, поэтому ступенчатое сужение кверху
# (350→300→250) задаётся мешами, а не параметром. Здесь остаётся только РИТМ.
#
# Две сущности, которые легко спутать в слове «этаж»:
#   • визуальные этажи — плотная стопка (MultiMesh), глухие, коллизии нет;
#   • палубы — редкие (2 на страту), с коллизией, сюда садятся и выходят.
# =============================================================================
extends Resource
class_name StrataDeckProfile

## Метка паттерна для читаемости в инспекторе ("A" / "B" / "C").
@export var pattern: String = "A"

## Шаг визуальных этажей (м) — высота этажа. Калибровка 2026-07-24 по камере:
## A(Доггерленд) 10, B(Манифолд) 15, C(Глэр) 20 — «чтобы камере было просторно».
@export_range(2.0, 40.0, 0.5) var visual_floor_pitch: float = 10.0

## Прореживание пирога: 0 — все плиты, 1 — через одну, 2 — через две.
## Фактический шаг = visual_floor_pitch × (skip + 1).
@export_range(0, 4, 1) var visual_floor_skip: int = 0

## Минимальный разнос двух палуб одной страты как доля высоты играбельной
## полосы. 0.4 → палубы не ближе 40% полосы, между ними остаётся ритм.
@export_range(0.1, 0.5, 0.05) var deck_min_separation_frac: float = 0.4
