# =============================================================================
# strata_deck_profile.gd — StrataDeckProfile (Resource)
# class_name: StrataDeckProfile
#
# Тюнинг-профиль вертикального ритма ОДНОЙ страты (паттерн A/B/C). Все числа,
# которые мы договорились ловить ногами, а не утверждать на бумаге, живут ЗДЕСЬ:
# правишь .tres в инспекторе, генератор не трогаешь (принцип «не костыль»).
#
# Привязка паттерна к страте — глобальная подпись мира:
#   Doggerland → A «варрен»      (густо, низкий потолок)
#   Manifold   → B «утилитарная» (средне)
#   Glare      → C «атриум»      (редко, высокий потолок)
#
# Разделяем ДВЕ сущности, которые легко спутать в слове «этаж»:
#   • визуальные этажи — плотный ритм плит (visual_floor_pitch), глухой фасад,
#     кормит фейк-интерьер; коллизии нет, по ним не ходят.
#   • палубы — редкие (по 2 на страту в башне): сюда садятся ховером и выходят;
#     коллизия floor(2), группа "floor". Их число фиксировано правилом (=2),
#     здесь настраивается только их РАЗНОС и габарит полки.
# =============================================================================
extends Resource
class_name StrataDeckProfile

## Метка паттерна для читаемости в инспекторе ("A" / "B" / "C").
@export var pattern: String = "A"

## Шаг визуальных этажей (м) — расстояние между плитами «пирога».
## Стартовые: A ~5, B ~7, C ~12. Под замену ногами.
@export_range(2.0, 40.0, 0.5) var visual_floor_pitch: float = 5.0

## Толщина плиты визуального этажа (м) — тонкая, чисто для читаемости ритма.
@export_range(0.2, 3.0, 0.1) var visual_floor_thickness: float = 0.5

## Минимальный разнос двух палуб одной страты как доля высоты играбельной
## полосы (0..0.5). 0.4 → палубы не ближе 40% высоты полосы, между ними
## гарантированно остаётся место на визуальный ритм.
@export_range(0.1, 0.5, 0.05) var deck_min_separation_frac: float = 0.4

## Толщина плиты палубы (м) — несущая, на неё садятся.
@export_range(0.5, 4.0, 0.1) var deck_slab_thickness: float = 1.5

## Вылет палубы-полки от фасада башни в каньон (м) — открытая площадка, к
## которой ховер подходит из каньона и садится. Greybox-аффорданс: сейчас
## палуба ПРОТОРЧИТ из башни как полка. Позже может стать нишей в фасаде.
@export_range(4.0, 40.0, 1.0) var deck_overhang: float = 15.0
