[gd_resource type="Resource" script_class="EquipmentLayout" format=3]

[ext_resource type="Script" path="res://core/equipment/equipment_layout.gd" id="1_layout"]
[ext_resource type="Script" path="res://core/equipment/equipment_slot_definition.gd" id="2_slotdef"]

[sub_resource type="Resource" id="Resource_legs"]
script = ExtResource("2_slotdef")
id = &"legs"
display_name = "Legs"
max_size = 1
refuses_threatening = false

[sub_resource type="Resource" id="Resource_torso"]
script = ExtResource("2_slotdef")
id = &"torso"
display_name = "Torso"
max_size = 1
refuses_threatening = false

[sub_resource type="Resource" id="Resource_feet"]
script = ExtResource("2_slotdef")
id = &"feet"
display_name = "Feet"
max_size = 1
refuses_threatening = false

[sub_resource type="Resource" id="Resource_back_pack"]
script = ExtResource("2_slotdef")
id = &"back_pack"
display_name = "Back — pack"
max_size = 2
refuses_threatening = false

[sub_resource type="Resource" id="Resource_back_unique"]
script = ExtResource("2_slotdef")
id = &"back_unique"
display_name = "Back — unique"
max_size = 2
refuses_threatening = true

[resource]
script = ExtResource("1_layout")
body_slots = Array[ExtResource("2_slotdef")]([SubResource("Resource_legs"), SubResource("Resource_torso"), SubResource("Resource_feet"), SubResource("Resource_back_pack"), SubResource("Resource_back_unique")])
